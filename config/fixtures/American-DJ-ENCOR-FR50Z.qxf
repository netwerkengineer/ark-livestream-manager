 </Creator>
 <Manufacturer>American DJ</Manufacturer>
 <Model>ENCOR FR50Z</Model>
 <Type>Color Changer</Type>
 <Channel Name="Master dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="dimmer fine" Preset="IntensityMasterDimmerFine"/>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="31">off</Capability>
  <Capability Min="32" Max="63">On</Capability>
  <Capability Min="64" Max="95">Variable Strobe, slow to fast</Capability>
  <Capability Min="96" Max="127">On</Capability>
  <Capability Min="128" Max="159">Pulse Effect, slow fasrt</Capability>
  <Capability Min="160" Max="191">On</Capability>
  <Capability Min="192" Max="223">Random Strobe, slow to fast</Capability>
  <Capability Min="224" Max="255">On</Capability>
 </Channel>
 <Channel Name="Dim Mode">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="20">Standard</Capability>
  <Capability Min="21" Max="40">Stage</Capability>
  <Capability Min="41" Max="60">TV</Capability>
  <Capability Min="61" Max="80">Architectural</Capability>
  <Capability Min="81" Max="100">Theatre</Capability>
  <Capability Min="101" Max="120">Stage 2</Capability>
  <Capability Min="121" Max="255">Default to unit setting</Capability>
 </Channel>
 <Mode Name="1CH">
  <Channel Number="0">Master dimmer</Channel>
 </Mode>
 <Mode Name="2CH">
  <Channel Number="0" ActsOn="1">Master dimmer</Channel>
  <Channel Number="1">Strobe</Channel>
 </Mode>
 <Mode Name="2-2CH">
  <Channel Number="0" ActsOn="1">Master dimmer</Channel>
  <Channel Number="1">dimmer fine</Channel>
 </Mode>
 <Mode Name="3CH">
  <Channel Number="0" ActsOn="2">Master dimmer</Channel>
  <Channel Number="1">Strobe</Channel>
  <Channel Number="2">Dim Mode</Channel>
 </Mode>
 <Mode Name="2-3CH">
  <Channel Number="0" ActsOn="2">Master dimmer</Channel>
  <Channel Number="1">dimmer fine</Channel>
  <Channel Number="2">Dim Mode</Channel>
 </Mode>
 <Mode Name="4CH">
  <Channel Number="0" ActsOn="3">Master dimmer</Channel>
  <Channel Number="1">dimmer fine</Channel>
  <Channel Number="2">Strobe</Channel>
  <Channel Number="3">Dim Mode</Channel>
 </Mode>
 <Physical>
